# Model checkpoints and binary artifacts
*.onnx
*.onnx.data
*.pt
examples/training/checkpoints/

# Per-user preferences and the PACKAGE Manifest (regenerable; BB resolves
# against its compat ranges instead of pinning one).
# Root-anchored: bmvc2026/Manifest.toml is TRACKED (2026-08-18) — the
# research project pins its environment the canonical DrWatson way, with
# BlobBoards dev'd by RELATIVE path (".."), so git checkout + Pkg.instantiate
# reproduces it on any machine.
LocalPreferences.toml
/Manifest.toml
/Manifest-v1.*.toml
/docs/Manifest.toml
/src/Manifest.toml
/gpu/Manifest.toml
/examples/Manifest.toml
/authoring/Manifest.toml
# Negation: the user-global gitignore also ignores Manifest.toml everywhere;
# this re-includes the ONE tracked research-project Manifest.
!bmvc2026/Manifest.toml

# Claude Code per-machine state
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
**/.claude/settings.local.json

# PythonCall / pixi / Python pip-package runtime
.CondaPkg/
.pixi/
.venv/
python/*.egg-info/
**/__pycache__/

# Legacy submodule remnants
deps/

