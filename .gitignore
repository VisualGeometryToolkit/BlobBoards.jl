# Model checkpoints and binary artifacts
*.onnx
*.onnx.data
*.pt
examples/training/checkpoints/

# Per-user preferences, and every Manifest: the repository is one Pkg
# workspace (the package, test/, docs/, gpu/, examples/, authoring/ and
# bmvc2026/) resolved in one root Manifest, which is regenerable and not
# committed; no member has a Manifest of its own.
LocalPreferences.toml
Manifest.toml
Manifest-v*.toml

# Claude Code per-machine state
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
**/.claude/settings.local.json

# PythonCall / pixi / Python pip-package runtime
.CondaPkg/
.pixi/
.venv/
python/*.egg-info/
**/__pycache__/

# Legacy submodule remnants
deps/

