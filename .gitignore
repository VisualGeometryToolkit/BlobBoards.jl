dev/traces/
# Parked, unreproducible run records (see dev/archive/README.md)
dev/archive/
# SLURM job logs (sbatch --output=logs/...)
logs/

# --- bmvc2026/ subproject (DrWatson) ---------------------------------------
# data/ is two symlinks: exp_raw (immutable inputs) and exp_pro (add-only
# outputs). Both point outside the repo; neither is ever committed.
bmvc2026/data/
bmvc2026/plots/
bmvc2026/_research/traces/

# bmvc2026 composed artifact view + consumer results (generated)
bmvc2026/output/

# bmvc2026 sweep shell logs (scratch, machine-local)
bmvc2026/sweep_*.log

# The paper is linked from arXiv, never shipped with the docs.
docs/**/*.pdf

# figures drawn by docs/diagrams.jl at build time
docs/src/assets/generated/
